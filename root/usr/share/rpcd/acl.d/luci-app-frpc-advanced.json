{
  "luci-app-frpc-advanced": {
    "description": "Grant access to LuCI app FRPC Advanced",
    "read": {
      "file": {
        "/etc/passwd": [
          "read"
        ]
      },
      "ubus": {
        "luci.frpc-advanced": [
          "get_status",
          "validate_backup"
        ],
        "log": [
          "read"
        ],
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "ubus": {
        "luci.frpc-advanced": [
          "restore_config",
          "get_version",
          "get_config_compare"
        ]
      },
      "uci": {
        "frpc-advanced": [
          "read",
          "write"
        ]
      }
    }
  }
}
